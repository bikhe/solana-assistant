{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Solana",
  "version": "0.1.0",
  "identifier": "dev.solana.assistant",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Solana",
        "width": 560,
        "height": 280,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "chat",
        "title": "Solana",
        "width": 440,
        "height": 640,
        "minWidth": 360,
        "minHeight": 420,
        "visible": false,
        "center": true
      },
      {
        "label": "settings",
        "title": "Solana",
        "width": 860,
        "height": 620,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false,
        "center": true
      },
      {
        "label": "wizard",
        "title": "Solana",
        "width": 640,
        "height": 580,
        "resizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
